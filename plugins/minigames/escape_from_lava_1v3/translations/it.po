msgid "ESCAPE_FROM_LAVA_FINISH_MSG"
msgstr "Fine!"

msgid "MINIGAME_ACTION_LEFT"
msgstr "Vai a sinistra"

msgid "MINIGAME_ACTION_RIGHT"
msgstr "Vai a destra"

msgid "MINIGAME_ACTION_OBSTRUCT"
msgstr "Porta ostruita"

msgid "MINIGAME_ACTION_UP"
msgstr "Vai avanti"

msgid "MINIGAME_ACTION_DOWN"
msgstr "Retrocedi"

msgid "MINIGAME_ACTION_OBSTRUCT_TWO"
msgstr "Porta ostruita 2 - solo giocatore singolo"

msgid "MINIGAME_DESCRIPTION"
msgstr ""
"I giocatori corrono l'uno contro l'altro per raggiungere la cima, mentre la "
"lava sale sotto di loro.\n"
"Devono passare attraverso più porte. Una di queste porte è bloccata e non si "
"apre.\n"
"Il primo giocatore che si salva in cima vince!"

msgid "MINIGAME_ACTION_OBSTRUCT_THREE"
msgstr "Porta ostruita 3 - solo giocatore singolo"

msgid "MINIGAME_NAME"
msgstr "Fuga dalla lava"
